<Window
    x:Class="Ricis.Robotics3D.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:vm="clr-namespace:Ricis.Robotics3D.App.ViewModels"
    Title="RICIS III 3D Arm Manipulator Automation Studio (DDD / MVVM)"
    Width="1180"
    Height="800"
    Background="#1E1E1E">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Left Control Panel  -->
        <Border
            Grid.Column="0"
            Margin="0,0,10,0"
            Padding="14"
            Background="#252526"
            CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Робототехника &amp; 3D Автоматизация" />

                    <!--  Automation Scenario Control Section  -->
                    <GroupBox
                        Margin="0,0,0,12"
                        Padding="8"
                        Foreground="#FFD700"
                        Header="Сценарий #1: Перекладывание Деталей">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding ScenarioStatusText}"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                Height="10"
                                Margin="0,0,0,8"
                                Foreground="#007ACC"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding ScenarioProgress}" />

                            <UniformGrid Margin="0,4,0,0" Columns="3">
                                <Button
                                    Margin="0,0,2,0"
                                    Padding="4,6"
                                    Background="#28A745"
                                    Command="{Binding StartScenarioCommand}"
                                    Content="▶ Запуск"
                                    FontWeight="Bold"
                                    Foreground="White" />
                                <Button
                                    Margin="2,0,2,0"
                                    Padding="4,6"
                                    Background="#FFC107"
                                    Command="{Binding PauseScenarioCommand}"
                                    Content="⏸ Пауза"
                                    FontWeight="Bold"
                                    Foreground="Black" />
                                <Button
                                    Margin="2,0,0,0"
                                    Padding="4,6"
                                    Background="#DC3545"
                                    Command="{Binding ResetScenarioCommand}"
                                    Content="🔄 Сброс"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <!--  GPU Management Section  -->
                    <GroupBox
                        Margin="0,0,0,12"
                        Padding="8"
                        Foreground="#4EC9B0"
                        Header="Управление GPU &amp; Рендерингом">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                Foreground="#DCDCDC"
                                Text="{Binding GpuStatusText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,2"
                                FontSize="12"
                                Foreground="White"
                                Text="Режим рендеринга:" />
                            <ComboBox Margin="0,0,0,6" SelectedIndex="{Binding SelectedRenderModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="AutoDetect (NVIDIA/iGPU)" />
                                <ComboBoxItem Content="Hardware High Performance (NVIDIA GTX 1650)" />
                                <ComboBoxItem Content="Hardware Compatibility (Integrated iGPU)" />
                                <ComboBoxItem Content="Software CPU Fallback" />
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <!--  3D Model Asset Section  -->
                    <GroupBox
                        Margin="0,0,0,12"
                        Padding="8"
                        Foreground="#4EC9B0"
                        Header="3D Модель Манипулятора">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="#DCDCDC"
                                Text="{Binding AssetText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <!--  Joint Controls  -->
                    <GroupBox
                        Margin="0,0,0,12"
                        Padding="8"
                        Foreground="#4EC9B0"
                        Header="Ручное Управление Суставами">
                        <StackPanel>
                            <TextBlock Foreground="White" Text="Joint 1 (Основание Theta 1):" />
                            <Slider
                                Margin="0,2,0,8"
                                Maximum="180"
                                Minimum="-180"
                                Value="{Binding Q1Degrees, Mode=TwoWay}" />

                            <TextBlock Foreground="White" Text="Joint 2 (Плечо Theta 2 - Полюс):" />
                            <Slider
                                Margin="0,2,0,8"
                                Maximum="180"
                                Minimum="-180"
                                Value="{Binding Q2Degrees, Mode=TwoWay}" />

                            <TextBlock Foreground="White" Text="Joint 3 (Локоть Theta 3):" />
                            <Slider
                                Margin="0,2,0,8"
                                Maximum="180"
                                Minimum="-180"
                                Value="{Binding Q3Degrees, Mode=TwoWay}" />

                            <Button
                                Margin="0,6,0,0"
                                Padding="6"
                                Background="#007ACC"
                                Command="{Binding ResetSingularCommand}"
                                Content="Сбросить в Сингулярную Точку (det=0)"
                                Foreground="White" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Right 3D Interactive Viewport Panel  -->
        <Border
            Grid.Column="1"
            Padding="12"
            Background="#2D2D30"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header Info Bar  -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="3D Интерактивная Сцена &amp; Промышленная Анимация" />
                    <Border
                        Grid.Column="1"
                        Padding="8,4"
                        Background="#383838"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#4EC9B0"
                            Text="{Binding SingularityStatusText}" />
                    </Border>
                </Grid>

                <!--  Interactive 3D Viewport with HelixToolkit  -->
                <Border
                    Grid.Row="1"
                    Background="#101010"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="6">
                    <helix:HelixViewport3D
                        Background="#121212"
                        ShowFrameRate="True"
                        ZoomExtentsWhenLoaded="True">
                        <!--  Lighting  -->
                        <helix:DefaultLights />

                        <!--  Ground Grid  -->
                        <helix:GridLinesVisual3D
                            Width="10"
                            Fill="#2A2A2A"
                            Length="10"
                            MajorDistance="1.0"
                            MinorDistance="0.2"
                            Thickness="0.01" />

                        <!--  Robot Arm and Workspace Scene Group  -->
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="RobotModelGroup" />
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </helix:HelixViewport3D>
                </Border>

                <!--  Overlay Telemetry Bar  -->
                <StackPanel
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="White"
                        Text="{Binding PositionText}" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFD700"
                        Text="{Binding JacobianText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
