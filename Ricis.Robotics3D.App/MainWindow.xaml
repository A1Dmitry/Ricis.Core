<Window x:Class="Ricis.Robotics3D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RICIS III 3D Arm Manipulator Control Studio" Height="700" Width="1050"
        Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Control Panel -->
        <Border Grid.Column="0" Background="#252526" CornerRadius="8" Padding="14" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Робототехника &amp; 3D Кинематика" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- GPU Management Section -->
                    <GroupBox Header="Управление GPU &amp; Рендерингом" Foreground="#4EC9B0" Margin="0,0,0,12" Padding="8">
                        <StackPanel>
                            <TextBlock x:Name="GpuStatusText" Foreground="#DCDCDC" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11"/>
                            <TextBlock Text="Режим рендеринга:" Foreground="White" Margin="0,4,0,2" FontSize="12"/>
                            <ComboBox x:Name="RenderModeCombo" SelectionChanged="RenderModeCombo_SelectionChanged" Margin="0,0,0,6">
                                <ComboBoxItem Content="AutoDetect (NVIDIA/iGPU)" IsSelected="True"/>
                                <ComboBoxItem Content="Hardware High Performance (NVIDIA GTX 1650)"/>
                                <ComboBoxItem Content="Hardware Compatibility (Integrated iGPU)"/>
                                <ComboBoxItem Content="Software CPU Fallback"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3D Model Asset Section -->
                    <GroupBox Header="Бесплатный 3D Asset Манипулятора" Foreground="#4EC9B0" Margin="0,0,0,12" Padding="8">
                        <StackPanel>
                            <TextBlock x:Name="AssetText" Foreground="#DCDCDC" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Joint Controls -->
                    <GroupBox Header="Управление Суставами (Joint Angles)" Foreground="#4EC9B0" Margin="0,0,0,12" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Joint 1 (Theta 1):" Foreground="White"/>
                            <Slider x:Name="Joint1Slider" Minimum="-180" Maximum="180" Value="0" ValueChanged="JointSlider_ValueChanged" Margin="0,2,0,8"/>

                            <TextBlock Text="Joint 2 (Theta 2 - Singularity Pole):" Foreground="White"/>
                            <Slider x:Name="Joint2Slider" Minimum="-180" Maximum="180" Value="0" ValueChanged="JointSlider_ValueChanged" Margin="0,2,0,8"/>

                            <TextBlock Text="Joint 3 (Theta 3):" Foreground="White"/>
                            <Slider x:Name="Joint3Slider" Minimum="-180" Maximum="180" Value="0" ValueChanged="JointSlider_ValueChanged" Margin="0,2,0,8"/>

                            <Button Content="Сбросить в Сингулярную Точку (det=0)" Click="ResetSingular_Click" Background="#007ACC" Foreground="White" Padding="6" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right 3D Viewport Simulation Panel -->
        <Border Grid.Column="1" Background="#2D2D30" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="3D Визуализация и Состояние Кинематики" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Simulated 3D Viewport Canvas / Status Box -->
                <Border Grid.Row="1" Background="#181818" CornerRadius="6" BorderBrush="#3F3F46" BorderThickness="1" Padding="16">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="[ 3D VIEWPORT CANVAS - OPENGL / DIRECTX / VULKAN ]" Foreground="#569CD6" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock x:Name="PositionText" Foreground="White" FontSize="16" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="JacobianText" Foreground="#FFD700" FontSize="16" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Singularity Warning / RICIS Active Indicator -->
                        <Border x:Name="SingularityBadge" Background="#383838" CornerRadius="4" Padding="10,6" HorizontalAlignment="Center">
                            <TextBlock x:Name="SingularityBadgeText" Text="СТАТУС: ШТАТНОЕ ДВИЖЕНИЕ" Foreground="#4EC9B0" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Status Footer -->
                <TextBlock Grid.Row="2" Text="RICIS III Engine active. Zero-division singularities eliminated by Indexed Zero/Infinity reduction." Foreground="#808080" Margin="0,10,0,0" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
