<Window x:Class="Ricis.Robotics3D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:Ricis.Robotics3D.App.ViewModels"
        Title="RICIS PUMA 560 Automation Studio (MVVM, procedural 6-DOF)" Height="800" Width="1180"
        Background="#1E1E1E">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Control Panel -->
        <Border Grid.Column="0" Background="#252526" CornerRadius="8" Padding="14" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Робототехника &amp; 3D Автоматизация" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Automation Scenario Control Section -->
                    <GroupBox Header="Сценарий #1: Перекладывание Деталей" Foreground="#FFD700" Margin="0,0,0,12" Padding="8">
                        <StackPanel>
                            <TextBlock Text="{Binding ScenarioStatusText}" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11" FontWeight="SemiBold"/>
                            <ProgressBar Value="{Binding ScenarioProgress}" Minimum="0" Maximum="100" Height="10" Margin="0,0,0,8" Foreground="#007ACC"/>

                            <UniformGrid Columns="3" Margin="0,4,0,0">
                                <Button Content="▶ Запуск" Command="{Binding StartScenarioCommand}" Background="#28A745" Foreground="White" Padding="4,6" Margin="0,0,2,0" FontWeight="Bold"/>
                                <Button Content="⏸ Пауза" Command="{Binding PauseScenarioCommand}" Background="#FFC107" Foreground="Black" Padding="4,6" Margin="2,0,2,0" FontWeight="Bold"/>
                                <Button Content="🔄 Сброс" Command="{Binding ResetScenarioCommand}" Background="#DC3545" Foreground="White" Padding="4,6" Margin="2,0,0,0" FontWeight="Bold"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <!-- GPU Management Section -->
                    <GroupBox Header="Управление GPU &amp; Рендерингом" Foreground="#4EC9B0" Margin="0,0,0,12" Padding="8">
                        <StackPanel>
                            <TextBlock Text="{Binding GpuStatusText}" Foreground="#DCDCDC" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11"/>
                            <TextBlock Text="Режим рендеринга:" Foreground="White" Margin="0,4,0,2" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding RenderModes}"
                                      SelectedItem="{Binding SelectedRenderMode, Mode=TwoWay}"
                                      Margin="0,0,0,6"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3D Model Asset Section -->
                    <GroupBox Header="3D Модель Манипулятора" Foreground="#4EC9B0" Margin="0,0,0,12" Padding="8">
                        <StackPanel>
                            <TextBlock Text="{Binding AssetText}" Foreground="#DCDCDC" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Joint Controls -->
                    <GroupBox Header="Ручное Управление Суставами" Foreground="#4EC9B0" Margin="0,0,0,12" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Joint 1 (Основание Theta 1):" Foreground="White"/>
                            <Slider Minimum="-180" Maximum="180" Value="{Binding Q1Degrees, Mode=TwoWay}" Margin="0,2,0,8"/>

                            <TextBlock Text="Joint 2 (Плечо Theta 2 - Полюс):" Foreground="White"/>
                            <Slider Minimum="-180" Maximum="180" Value="{Binding Q2Degrees, Mode=TwoWay}" Margin="0,2,0,8"/>

                            <TextBlock Text="Joint 3 (Локоть Theta 3):" Foreground="White"/>
                            <Slider Minimum="-180" Maximum="180" Value="{Binding Q3Degrees, Mode=TwoWay}" Margin="0,2,0,8"/>

                            <TextBlock Text="Joint 4 (Запястье Theta 4):" Foreground="White"/>
                            <Slider Minimum="-180" Maximum="180" Value="{Binding Q4Degrees, Mode=TwoWay}" Margin="0,2,0,8"/>

                            <TextBlock Text="Joint 5 (Запястье Theta 5):" Foreground="White"/>
                            <Slider Minimum="-180" Maximum="180" Value="{Binding Q5Degrees, Mode=TwoWay}" Margin="0,2,0,8"/>

                            <TextBlock Text="Joint 6 (Фланец Theta 6):" Foreground="White"/>
                            <Slider Minimum="-180" Maximum="180" Value="{Binding Q6Degrees, Mode=TwoWay}" Margin="0,2,0,8"/>

                            <Button Content="Сбросить в Сингулярную Точку (det=0)" Command="{Binding ResetSingularCommand}" Background="#007ACC" Foreground="White" Padding="6" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right 3D Interactive Viewport Panel -->
        <Border Grid.Column="1" Background="#2D2D30" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Info Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="3D Интерактивная Сцена &amp; Промышленная Анимация" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <Border Grid.Column="1" Background="#383838" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding SingularityStatusText}" Foreground="#4EC9B0" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </Grid>

                <!-- Interactive 3D Viewport with HelixToolkit -->
                <Border Grid.Row="1" Background="#101010" CornerRadius="6" BorderBrush="#3F3F46" BorderThickness="1" ClipToBounds="True">
                    <helix:HelixViewport3D ShowFrameRate="True" ZoomExtentsWhenLoaded="True" Background="#121212">
                        <!-- Lighting -->
                        <helix:DefaultLights/>

                        <!-- Ground Grid -->
                        <helix:GridLinesVisual3D Width="10" Length="10" MinorDistance="0.2" MajorDistance="1.0" Thickness="0.01" Fill="#2A2A2A"/>

                        <!-- Robot Arm and Workspace Scene Group -->
                        <ModelVisual3D Content="{Binding SceneModel}"/>
                    </helix:HelixViewport3D>
                </Border>

                <!-- Overlay Telemetry Bar -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="{Binding PositionText}" Foreground="White" FontSize="13" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding JacobianText}" Foreground="#FFD700" FontSize="13" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
